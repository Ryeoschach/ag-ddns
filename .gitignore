# 依赖包目录
node_modules/

# 服务端本地持久化数据（保存任务数据库、配置与动态凭证）
server/data/

# 客户端本地敏感配置及 IP 缓存
client/config.json
client/ip.cache

# 脚本运行产生的日志文件
*.log
logs/

# 临时与备份文件
*.tmp
*.temp
*.bak
*.swp

# 操作系统生成文件
.DS_Store
.DS_Store?
ehthumbs.db
Thumbs.db

# 编辑器与 IDE 配置目录
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# 临时测试目录或文件
scratch/db.json
scratch/ip.cache
